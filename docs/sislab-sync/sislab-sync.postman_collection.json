    {
      "name": "2 — Percurso do laboratorio (papel de SISLAB)",
      "description": "Cada passo escreve mais um evento na outbox. A ordem segue a maquina de estados de app/models/order.rb: requested -> accepted -> specimen_collected -> in_progress -> completed. Saltar um passo devolve 422, de proposito.",
      "item": [
        {
          "name": "Fila do laboratorio",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v3/lab/pending-orders?lab_code={{lab_code}}&limit=50",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v3",
                "lab",
                "pending-orders"
              ],
              "query": [
                {
                  "key": "lab_code",
                  "value": "{{lab_code}}"
                },
                {
                  "key": "limit",
                  "value": "50"
                }
              ]
            },
            "description": "Tudo o que mudou desde o cursor. Passe since=<next_cursor> para paginar."
          },
          "response": []
        },
        {
          "name": "Reclamar o pedido",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
