            ],
            "url": {
              "raw": "{{base_url}}/api/v3/lab/orders/{{tracking_number}}/claim",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v3",
                "lab",
                "orders",
                "{{tracking_number}}",
                "claim"
              ]
            },
            "description": "requested -> accepted. Reclamar duas vezes devolve 409 conflict.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"actor\": \"Tec. Sofia Matola\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
