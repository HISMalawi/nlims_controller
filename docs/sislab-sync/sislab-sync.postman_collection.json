                "{{base_url}}"
              ],
              "path": [
                "api",
                "v3",
                "lab",
                "referrals"
              ]
            },
            "description": "So a partir de `in_progress` — a referencia poe o pedido em `referred_out`. Corra antes os passos da pasta 2 ate 'Em analise'. Escreve referral.dispatched. Guarda o uuid em {{referral_uuid}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tracking_number\": \"{{tracking_number}}\",\n  \"to_facility_code\": \"HPM\",\n  \"to_lab_code\": \"HPM-LAB\",\n  \"courier\": \"Motorista Chico\",\n  \"remarks\": \"Sem reagente hoje, enviado para o HPM.\",\n  \"actor\": \"Tec. Sofia Matola\"\n}",
              "options": {
