              "mode": "raw",
              "raw": "{\n  \"patient\": {\n    \"national_id\": \"120000000123T\",\n    \"name\": \"Alzira Muianga\",\n    \"sex\": \"F\",\n    \"birthdate\": \"1990-04-12\",\n    \"phone\": \"840000123\"\n  },\n  \"order\": {\n    \"sending_facility_code\": \"{{facility_code}}\",\n    \"receiving_lab_code\": \"{{lab_code}}\",\n    \"priority\": \"routine\",\n    \"requested_by\": \"Dr. Alberto Nhaca\",\n    \"order_location\": \"Consulta externa\",\n    \"clinical_history\": \"Dados de teste para verificar a sincronizacao com o no nacional.\",\n    \"collected_at\": \"2026-08-18T09:00:00+02:00\",\n    \"specimen_type\": {\n      \"national_code\": \"MOZ-SP-0001\"\n    }\n  },\n  \"tests\": [\n    {\n      \"test_type\": {\n        \"national_code\": \"MOZ-TT-0001\"\n      }\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "if (b.data && b.data.tracking_number) {",
                  "  pm.collectionVariables.set('tracking_number', b.data.tracking_number);",
                  "  console.log('tracking_number =', b.data.tracking_number);",
                  "}",
                  "pm.test('201 criado', () => pm.response.to.have.status(201));"
                ]
