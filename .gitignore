# See https://help.github.com/articles/ignoring-files for more about ignoring files.

/.bundle

/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/tmp/pids/*
!/tmp/pids/.keep
/tmp/storage/*
!/tmp/storage/.keep

/public/assets
/app/assets/builds/*
!/app/assets/builds/.keep
/node_modules

# Local environment. Committed only as .env.*.example.
.env
.env.local
.env.*.local

/config/master.key
/config/credentials/*.key

.byebug_history
.ruby-lsp/

# Local bundler install path (Docker is the supported path).
/vendor/bundle
