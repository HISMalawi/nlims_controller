# See https://help.github.com/articles/ignoring-files for more about ignoring files.

/.bundle

/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/tmp/pids/*
!/tmp/pids/.keep
/tmp/storage/*
!/tmp/storage/.keep

/public/assets
/app/assets/builds/*
!/app/assets/builds/.keep
/node_modules

# Local environment. Committed only as .env.*.example.
.env
.env.local
.env.*.local

/config/master.key
/config/credentials/*.key

.byebug_history
.ruby-lsp/

# Local bundler install path (Docker is the supported path).
/vendor/bundle

# Local compose adjustments (this node runs RAILS_ENV=production).
/docker-compose.override.yml

# Knowledge graph (graphify). The graph itself is committed; what is derived
# from it, machine-local or rewritten on every run is not.
/graphify-out/cache/
/graphify-out/20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
/graphify-out/graph.html
/graphify-out/cost.json
/graphify-out/.graphify_root
/graphify-out/.graphify_python
/graphify-out/manifest.json
