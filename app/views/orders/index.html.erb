<% content_for :title, t(".title") %>

<h1 class="text-2xl font-semibold tracking-tight"><%= t(".title") %></h1>

<%= form_with url: orders_path, method: :get, class: "mt-6 rounded-xl border border-slate-200 bg-white p-4 shadow-sm" do |form| %>
  <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-6">
    <div class="lg:col-span-2">
      <%= form.label :q, t("orders.search.label"), class: "block text-xs font-medium text-slate-600" %>
      <%= form.search_field :q, value: @search.term, autofocus: true,
            placeholder: t("orders.search.placeholder"),
            class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-1.5 text-sm shadow-sm
                    focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" %>
    </div>

    <div>
      <%= form.label :status, t("orders.columns.status"), class: "block text-xs font-medium text-slate-600" %>
      <%= form.select :status,
            Order.status_machine.statuses.map { |s| [t("orders.statuses.#{s}"), s] },
            { include_blank: t("orders.search.any_status"), selected: @search.status },
            class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-1.5 text-sm shadow-sm
                    focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" %>
    </div>

    <div>
      <%= form.label :facility, t("orders.columns.facility"), class: "block text-xs font-medium text-slate-600" %>
      <%= form.text_field :facility, value: @search.facility,
            class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-1.5 font-mono text-sm uppercase shadow-sm
                    focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" %>
    </div>

    <div>
      <%= form.label :from, t("orders.search.from"), class: "block text-xs font-medium text-slate-600" %>
      <%= form.date_field :from, value: @search.from,
            class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-1.5 text-sm shadow-sm
                    focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" %>
    </div>

    <div>
      <%= form.label :to, t("orders.search.to"), class: "block text-xs font-medium text-slate-600" %>
      <%= form.date_field :to, value: @search.to,
            class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-1.5 text-sm shadow-sm
                    focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" %>
    </div>
  </div>

  <div class="mt-3 flex items-center gap-3">
    <%= form.submit t("orders.search.submit"),
          class: "cursor-pointer rounded-md bg-slate-900 px-3 py-1.5 text-sm font-medium text-white hover:bg-slate-800" %>
    <% if @search.filtered? %>
      <%= link_to t("orders.search.clear"), orders_path, class: "text-sm text-slate-500 hover:text-slate-900" %>
    <% end %>
  </div>
<% end %>

<div class="mt-6">
  <%= panel t(".results", count: @search.total) do %>
    <% if @search.results.empty? %>
      <%= render "shared/empty",
            message: @search.filtered? ? t(".none_found") : t(".none_yet"),
            hint: @search.filtered? ? t(".none_found_hint") : nil %>
    <% else %>
      <%= render "orders/table", orders: @search.results %>
      <%= render "shared/pagination", page: @search.page, pages: @search.pages, query: request.query_parameters %>
    <% end %>
  <% end %>
</div>
