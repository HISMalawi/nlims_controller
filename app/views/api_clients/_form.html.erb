<%= form_with model: client, class: "space-y-4" do |form| %>
  <% if client.errors.any? %>
    <div class="rounded-md border border-rose-300 bg-rose-50 px-4 py-3 text-sm text-rose-900">
      <ul class="list-inside list-disc">
        <% client.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, class: "block text-sm font-medium text-slate-700" %>
    <%= form.text_field :name, required: true,
          class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 shadow-sm
                  focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" %>
  </div>

  <div>
    <%= form.label :kind, t("api_clients.columns.kind"), class: "block text-sm font-medium text-slate-700" %>
    <% if client.persisted? %>
      <%# Kind decides which facility and lab checks apply to every request the
          client makes. Changing it would silently re-scope keys already in the
          field, so it is stated rather than offered. %>
      <p class="mt-1 text-sm text-slate-900"><%= t("api_clients.kinds.#{client.kind}") %></p>
      <p class="mt-1 text-xs text-slate-500"><%= t("api_clients.kind_is_fixed") %></p>
    <% else %>
      <%= form.select :kind,
            ApiClient::KINDS.map { |kind| [t("api_clients.kinds.#{kind}"), kind] },
            {},
            class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 shadow-sm
                    focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" %>
    <% end %>
  </div>

  <%# The two code boxes that used to be here are gone. A node is a laboratory
      and knows its own code, and the health facility comes from its entry in
      the national register — so an EMR being connected here belongs to this
      laboratory by construction. Stating it is useful; asking for it was not,
      and a mistyped code refused the integration with a 403 nobody could
      diagnose from the other end. %>
  <% if SislabSync.local? %>
    <div class="rounded-md border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-700">
      <p><%= t("api_clients.node_identity_html", facility: tag.span(SislabSync.node_name, class: "font-medium"),
                                                 code: tag.span(SislabSync.facility_code, class: "font-mono")) %></p>
      <% if SislabSync.facility.nil? %>
        <p class="mt-1 text-xs text-amber-700"><%= t("api_clients.node_not_in_register") %></p>
      <% end %>
    </div>
  <% end %>

  <label class="flex items-center gap-2 text-sm text-slate-700">
    <%= form.check_box :active, class: "rounded border-slate-300 text-slate-900 focus:ring-slate-500" %>
    <%= t("api_clients.active_label") %>
  </label>

  <div class="flex items-center gap-3">
    <%= form.submit class: "cursor-pointer rounded-md bg-slate-900 px-3 py-2 text-sm font-medium text-white hover:bg-slate-800" %>
    <%= link_to t("cancel"), client.persisted? ? api_client_path(client) : api_clients_path,
          class: "text-sm text-slate-500 hover:text-slate-900" %>
  </div>
<% end %>
