<% content_for :title, t(".title") %>

<%= link_to @client.name, api_client_path(@client), class: "text-xs text-slate-500 hover:text-slate-900" %>
<h1 class="mt-1 text-2xl font-semibold tracking-tight"><%= t(".title") %></h1>
<p class="mt-2 max-w-prose text-sm text-slate-600"><%= t(".lede") %></p>

<div class="mt-6 max-w-2xl rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
  <%= form_with url: api_client_api_keys_path(@client), method: :post, class: "space-y-5" do |form| %>
    <fieldset>
      <legend class="text-sm font-medium text-slate-700"><%= t(".scopes") %></legend>
      <p class="mt-1 text-xs text-slate-500"><%= t(".scopes_hint") %></p>

      <div class="mt-3 space-y-2">
        <% @scopes.each do |scope| %>
          <label class="flex items-start gap-2">
            <%= check_box_tag "scopes[]", scope, @suggested.include?(scope), id: "scope_#{scope.parameterize}",
                  class: "mt-1 rounded border-slate-300 text-slate-900 focus:ring-slate-500" %>
            <span>
              <span class="font-mono text-sm text-slate-900"><%= scope %></span>
              <span class="block text-xs text-slate-500"><%= t("api_keys.scopes.#{scope.tr(':', '_')}") %></span>
            </span>
          </label>
        <% end %>
      </div>
    </fieldset>

    <div>
      <%= label_tag :expires_on, t(".expires_on"), class: "block text-sm font-medium text-slate-700" %>
      <%= date_field_tag :expires_on, nil,
            class: "mt-1 rounded-md border border-slate-300 px-3 py-2 shadow-sm
                    focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" %>
      <p class="mt-1 text-xs text-slate-500"><%= t(".expires_on_hint") %></p>
    </div>

    <div class="flex items-center gap-3">
      <%= form.submit t(".submit"),
            class: "cursor-pointer rounded-md bg-slate-900 px-3 py-2 text-sm font-medium text-white hover:bg-slate-800" %>
      <%= link_to t("cancel"), api_client_path(@client), class: "text-sm text-slate-500 hover:text-slate-900" %>
    </div>
  <% end %>
</div>
