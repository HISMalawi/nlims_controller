<% content_for :title, t(".title") %>

<h1 class="text-2xl font-semibold tracking-tight"><%= t(".title") %></h1>
<p class="mt-2 max-w-prose text-sm text-slate-600"><%= t(".lede") %></p>

<div class="mt-6 grid gap-4 sm:grid-cols-3">
  <%= stat t(".node_code"), SislabSync.node_code %>
  <%= stat t(".version"), SislabSync.version %>
  <%= stat t(".environment"), Rails.env %>
</div>

<p class="mt-8 text-sm text-slate-500"><%= t(".pending") %></p>
