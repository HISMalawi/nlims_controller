<% content_for :title, t(".title") %>

<div class="min-h-screen bg-slate-50 text-slate-900">
  <div class="mx-auto max-w-3xl px-6 py-16">
    <p class="text-xs font-semibold uppercase tracking-widest text-emerald-700">
      <%= t(".mode.#{SislabSync.mode}") %>
    </p>

    <h1 class="mt-3 text-4xl font-semibold tracking-tight">SISLAB Sync</h1>

    <p class="mt-3 max-w-prose text-slate-600"><%= t(".lede") %></p>

    <dl class="mt-10 grid grid-cols-2 gap-x-8 gap-y-6 border-t border-slate-200 pt-8 sm:grid-cols-3">
      <div>
        <dt class="text-xs font-semibold uppercase tracking-wider text-slate-500"><%= t(".node_code") %></dt>
        <dd class="mt-1 font-mono text-lg"><%= SislabSync.node_code %></dd>
      </div>
      <div>
        <dt class="text-xs font-semibold uppercase tracking-wider text-slate-500"><%= t(".version") %></dt>
        <dd class="mt-1 font-mono text-lg"><%= SislabSync.version %></dd>
      </div>
      <div>
        <dt class="text-xs font-semibold uppercase tracking-wider text-slate-500"><%= t(".environment") %></dt>
        <dd class="mt-1 font-mono text-lg"><%= Rails.env %></dd>
      </div>
    </dl>

    <p class="mt-10 text-sm text-slate-500"><%= t(".pending") %></p>
  </div>
</div>
