<style type="text/css">
  @media only screen and (max-width: 600px) {
    .email-card { border-left: 0 !important; border-right: 0 !important; }
    .email-header, .email-content { padding-left: 16px !important; padding-right: 16px !important; }
    .email-title { font-size: 21px !important; }
    .stock-table thead { display: none !important; }
    .stock-table, .stock-table tbody, .stock-table tr, .stock-table td { display: block !important; width: 100% !important; }
    .stock-table tr { margin-bottom: 16px !important; border: 1px solid #cbd5e1 !important; }
    .stock-table td { box-sizing: border-box !important; min-height: 40px !important; padding: 10px 12px !important; border: 0 !important; border-bottom: 1px solid #e2e8f0 !important; text-align: left !important; white-space: normal !important; }
    .stock-table td:last-child { border-bottom: 0 !important; }
    .mobile-label { color: #475569 !important; display: block !important; font-size: 12px !important; font-weight: 700 !important; line-height: 1.3 !important; margin-bottom: 4px !important; text-transform: uppercase !important; }
  }
</style>

<div class="email-card" style="max-width: 760px; margin: 0 auto; background-color: #ffffff; border: 1px solid #e2e8f0;">
  <div class="email-header" style="padding: 24px 28px 20px; border-bottom: 4px solid #dc2626;">
    <h1 class="email-title" style="margin: 0; color: #1e293b; font-size: 24px; font-weight: 700; line-height: 1.3;">Expired Stock Written Off</h1>
    <p style="margin: 10px 0 0; color: #475569; font-size: 15px; line-height: 1.5;">
      <strong style="color: #b91c1c;"><%= @stock_transactions.count %></strong> expired stock lot(s) were automatically written off.
    </p>
  </div>

  <div class="email-content" style="padding: 24px 28px 28px;">
    <table class="stock-table" width="100%" cellpadding="0" cellspacing="0" role="presentation" style="border-collapse: collapse; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; font-size: 14px; color: #334155; text-align: left;">
  <thead>
    <tr style="background-color: #f1f5f9;">
      <th style="padding: 12px; border: 1px solid #cbd5e1; color: #334155; font-size: 12px; font-weight: 700; text-transform: uppercase;">Stock ID</th>
      <th style="padding: 12px; border: 1px solid #cbd5e1; color: #334155; font-size: 12px; font-weight: 700; text-transform: uppercase;">Lot</th>
      <th style="padding: 12px; border: 1px solid #cbd5e1; color: #334155; font-size: 12px; font-weight: 700; text-transform: uppercase;">Batch</th>
      <th style="padding: 12px; border: 1px solid #cbd5e1; color: #334155; font-size: 12px; font-weight: 700; text-transform: uppercase; white-space: nowrap;">Expiry Date</th>
      <th style="padding: 12px; border: 1px solid #cbd5e1; color: #334155; font-size: 12px; font-weight: 700; text-align: right; text-transform: uppercase; white-space: nowrap;">Quantity Written Off</th>
    </tr>
  </thead>
  <tbody>
    <% @stock_transactions.each do |transaction| %>
      <tr>
        <td style="padding: 12px; border: 1px solid #e2e8f0;"><span class="mobile-label" style="display: none;">Stock ID</span><%= transaction['stock_id'] %></td>
        <td style="padding: 12px; border: 1px solid #e2e8f0;"><span class="mobile-label" style="display: none;">Lot</span><%= transaction['lot'] %></td>
        <td style="padding: 12px; border: 1px solid #e2e8f0;"><span class="mobile-label" style="display: none;">Batch</span><%= transaction['batch'] %></td>
        <td style="padding: 12px; border: 1px solid #e2e8f0; white-space: nowrap;"><span class="mobile-label" style="display: none;">Expiry Date</span><%= transaction['expiry_date']&.to_date %></td>
        <td style="padding: 12px; border: 1px solid #e2e8f0; font-weight: 600; text-align: right;"><span class="mobile-label" style="display: none;">Quantity Written Off</span><%= transaction['remaining_balance'] %></td>
      </tr>
    <% end %>
  </tbody>
    </table>
  </div>
</div>