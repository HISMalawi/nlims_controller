<header class="border-b border-slate-200 bg-white">
  <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-3 px-4 py-3 sm:px-6 lg:px-8">
    <span class="text-sm text-slate-500"><%= content_for(:title) %></span>

    <div class="flex items-center gap-3 text-sm">
      <span class="hidden text-slate-600 sm:inline"><%= current_user.name %></span>
      <% if current_user.admin? %>
        <span class="rounded-full bg-slate-200 px-2 py-0.5 text-xs font-medium text-slate-700">
          <%= t("users.roles.admin") %>
        </span>
      <% end %>
      <%= button_to t("auth.sign_out"), session_path, method: :delete,
            class: "rounded-md px-2 py-1 text-sm font-medium text-slate-600 hover:bg-slate-100 hover:text-slate-900" %>
    </div>
  </div>
</header>
