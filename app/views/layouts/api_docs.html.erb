<!DOCTYPE html>
<html lang="<%= I18n.locale %>" class="h-full">
  <head>
    <title><%= [content_for(:title), t("app_name")].compact_blank.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= t("api_docs.meta_description") %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">

    <%# No importmap. This page is read by someone who may be on a telephone %>
    <%# tethered at a district hospital, and it has nothing to do that needs JavaScript. %>
    <%= stylesheet_link_tag :tailwind, "data-turbo-track": "reload" %>
  </head>

  <body class="h-full bg-white text-slate-900 antialiased">
    <%= yield %>
  </body>
</html>
