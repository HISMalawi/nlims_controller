<% content_for :title, t("dictionary.entities.#{@entity_type}") %>

<div class="flex flex-wrap items-start justify-between gap-3">
  <div>
    <%= link_to t("dictionary.index.title"), dictionary_path, class: "text-xs text-slate-500 hover:text-slate-900" %>
    <h1 class="mt-1 text-2xl font-semibold tracking-tight"><%= t("dictionary.entities.#{@entity_type}") %></h1>
  </div>

  <% if SislabSync.national? && current_user.admin? %>
    <%= link_to t(".new"), new_dictionary_entry_path(@entity_type),
          class: "rounded-md bg-slate-900 px-3 py-2 text-sm font-medium text-white hover:bg-slate-800" %>
  <% end %>
</div>

<%# The coverage figure is the point of the curation this screen exists for:
    the imported catalogue arrived with none at all, and a percentage makes it
    a task somebody can finish rather than an intention. %>
<div class="mt-6 grid gap-4 sm:grid-cols-3">
  <%= stat t(".total"), @total %>
  <%= stat t(".loinc_coverage"),
        @active_total.zero? ? "—" : "#{((@with_loinc / @active_total.to_f) * 100).round}%",
        tone: @with_loinc.zero? ? :bad : (@with_loinc < @active_total ? :waiting : :good),
        hint: t(".loinc_hint", covered: @with_loinc, total: @active_total) %>
</div>

<%= form_with url: dictionary_entity_path(@entity_type), method: :get, class: "mt-6 flex flex-wrap items-end gap-3" do |form| %>
  <div>
    <%= form.label :q, t(".search"), class: "block text-xs font-medium text-slate-600" %>
    <%= form.search_field :q, value: @term, placeholder: t(".search_placeholder"),
          class: "mt-1 w-72 rounded-md border border-slate-300 px-3 py-1.5 text-sm shadow-sm
                  focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" %>
  </div>

  <div>
    <%= form.label :status, t("orders.columns.status"), class: "block text-xs font-medium text-slate-600" %>
    <%= form.select :status,
          DictionaryEntry::STATUSES.map { |s| [t("dictionary.statuses.#{s}"), s] },
          { include_blank: t(".any_status"), selected: @status },
          class: "mt-1 rounded-md border border-slate-300 px-3 py-1.5 text-sm shadow-sm
                  focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" %>
  </div>

  <%= form.submit t(".apply"),
        class: "cursor-pointer rounded-md bg-slate-900 px-3 py-1.5 text-sm font-medium text-white hover:bg-slate-800" %>
<% end %>

<div class="mt-4">
  <%= panel do %>
    <% if @entries.empty? %>
      <%= render "shared/empty", message: t(".none") %>
    <% else %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-200 text-sm">
          <thead class="bg-slate-50 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
            <tr>
              <th class="px-5 py-2.5"><%= t("dictionary.columns.national_code") %></th>
              <th class="px-5 py-2.5"><%= t("dictionary.columns.name") %></th>
              <th class="px-5 py-2.5"><%= t("dictionary.columns.loinc") %></th>
              <th class="px-5 py-2.5"><%= t("dictionary.columns.revision") %></th>
              <th class="px-5 py-2.5"><%= t("orders.columns.status") %></th>
              <% if SislabSync.national? && current_user.admin? %>
                <th class="px-5 py-2.5"></th>
              <% end %>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% @entries.each do |entry| %>
              <tr class="hover:bg-slate-50">
                <td class="px-5 py-2.5 font-mono text-xs text-slate-700"><%= entry.national_code %></td>
                <td class="px-5 py-2.5">
                  <span class="text-slate-900"><%= entry.name %></span>
                  <% if entry.short_name.present? && entry.short_name != entry.name %>
                    <span class="block text-xs text-slate-500"><%= entry.short_name %></span>
                  <% end %>
                </td>
                <td class="px-5 py-2.5">
                  <% if entry.loinc_code.present? %>
                    <span class="font-mono text-xs text-slate-700"><%= entry.loinc_code %></span>
                  <% else %>
                    <span class="text-xs text-slate-400"><%= t("dictionary.no_loinc") %></span>
                  <% end %>
                </td>
                <td class="px-5 py-2.5 tabular text-xs text-slate-500"><%= entry.revision %></td>
                <td class="px-5 py-2.5"><%= status_badge entry.status, scope: "dictionary.statuses" %></td>
                <% if SislabSync.national? && current_user.admin? %>
                  <td class="px-5 py-2.5 text-right">
                    <div class="flex justify-end gap-2">
                      <%= link_to t("dictionary.show.edit"), edit_dictionary_entry_path(@entity_type, entry.national_code),
                            class: "rounded-md border border-slate-300 bg-white px-2 py-1 text-xs font-medium text-slate-700 hover:bg-slate-50" %>
                      <% if entry.draft? %>
                        <%= button_to t("dictionary.show.activate"),
                              activate_dictionary_entry_path(@entity_type, entry.national_code),
                              class: "rounded-md border border-emerald-300 bg-white px-2 py-1 text-xs font-medium text-emerald-700 hover:bg-emerald-50" %>
                      <% elsif entry.active? %>
                        <%= button_to t("dictionary.show.retire"),
                              retire_dictionary_entry_path(@entity_type, entry.national_code),
                              form: { data: { turbo_confirm: t("dictionary.show.retire_confirm", name: entry.name) } },
                              class: "rounded-md border border-slate-300 bg-white px-2 py-1 text-xs font-medium text-slate-700 hover:bg-slate-50" %>
                      <% end %>
                    </div>
                  </td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <%= render "shared/pagination", page: @page, pages: @pages, query: request.query_parameters %>
    <% end %>
  <% end %>
</div>
