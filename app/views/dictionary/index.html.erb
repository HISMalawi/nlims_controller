<% content_for :title, t(".title") %>

<div class="flex flex-wrap items-start justify-between gap-3">
  <div>
    <h1 class="text-2xl font-semibold tracking-tight"><%= t(".title") %></h1>
    <p class="mt-2 max-w-prose text-sm text-slate-600">
      <%= SislabSync.national? ? t(".lede_national") : t(".lede_local") %>
    </p>
  </div>

  <% if SislabSync.national? && current_user.admin? && @counts.values.sum { |c| c[:draft] }.positive? %>
    <%= button_to t(".promote_all"), promote_dictionary_path,
          form: { data: { turbo_confirm: t(".promote_confirm") } },
          class: "rounded-md bg-slate-900 px-3 py-2 text-sm font-medium text-white hover:bg-slate-800" %>
  <% end %>
</div>

<div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
  <%= stat t(".revision"), @cursor, hint: t(".revision_hint") %>

  <% if @local_cursor %>
    <%= stat t(".local_cursor"), @local_cursor.value,
          tone: @local_cursor.healthy? ? :neutral : :bad,
          hint: t(".local_cursor_hint", when: @local_cursor.last_synced_at ? l(@local_cursor.last_synced_at, format: :short) : t("dashboard.sync.never_short")) %>
  <% end %>

  <%= stat t(".loinc"), @loinc.percentage ? "#{@loinc.percentage}%" : "—",
        tone: @loinc.covered.zero? ? :bad : (@loinc.missing.positive? ? :waiting : :good),
        hint: t(".loinc_hint", covered: @loinc.covered, total: @loinc.total) %>

  <% if @quality&.any? %>
    <div class="rounded-xl border border-amber-300 bg-amber-50 px-5 py-4 sm:col-span-2 lg:col-span-2">
      <p class="text-xs font-medium uppercase tracking-wide text-amber-800"><%= t(".quality") %></p>
      <ul class="mt-2 space-y-1 text-sm text-amber-900">
        <% @quality.sort_by { |_, count| -count }.each do |issue, count| %>
          <li>
            <span class="tabular font-semibold"><%= count %></span>
            <%= t("dictionary.issues.#{issue}", default: issue.to_s.humanize) %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>
</div>

<div class="mt-6">
  <%= panel do %>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-slate-200 text-sm">
        <thead class="bg-slate-50 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
          <tr>
            <th class="px-5 py-2.5"><%= t(".entity") %></th>
            <th class="px-5 py-2.5"><%= t("dictionary.statuses.active") %></th>
            <th class="px-5 py-2.5"><%= t("dictionary.statuses.draft") %></th>
            <th class="px-5 py-2.5"><%= t("dictionary.statuses.retired") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @counts.each do |entity_type, counts| %>
            <tr class="hover:bg-slate-50">
              <td class="px-5 py-2.5">
                <%= link_to t("dictionary.entities.#{entity_type}"), dictionary_entity_path(entity_type),
                      class: "font-medium text-slate-900 underline-offset-2 hover:underline" %>
              </td>
              <td class="px-5 py-2.5 tabular text-slate-900"><%= counts[:active] %></td>
              <td class="px-5 py-2.5 tabular <%= counts[:draft].positive? ? "font-medium text-amber-700" : "text-slate-400" %>">
                <%= counts[:draft] %>
              </td>
              <td class="px-5 py-2.5 tabular text-slate-400"><%= counts[:retired] %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
