<%# One schema as a list of fields, recursing into the objects and arrays inside %>
<%# it. Composition is followed rather than shown: a reader wants the fields %>
<%# that come back, not the four schemas they were assembled from. %>
<% schema = ApiContract.expand(schema) %>
<% required = Array(schema["required"]) %>
<% properties = schema["properties"] %>
<% items = schema["items"] %>

<% if depth > 4 %>
  <p class="contract-field-body"><%= t("api_docs.nested_further") %></p>
<% elsif properties.present? %>
  <ul class="contract-fields">
    <% properties.each do |name, property| %>
      <% expanded = ApiContract.expand(property) %>
      <li class="contract-field">
        <div class="contract-field-head">
          <code class="contract-name"><%= name %></code>
          <span class="contract-meta"><%= contract_type(expanded) %></span>
          <% if required.include?(name) %>
            <span class="contract-required"><%= t("api_docs.always_present") %></span>
          <% end %>
        </div>

        <div class="contract-prose contract-field-body"><%= contract_prose(expanded["description"]) %></div>

        <% if (values = contract_enum(expanded)) %>
          <p class="contract-field-body">
            <% values.each do |value| %><code class="contract-code"><%= value %></code> <% end %>
          </p>
        <% end %>

        <% if expanded["properties"].present? || ApiContract.expand(expanded["items"] || {})["properties"].present? %>
          <div class="contract-nested">
            <%= render "schema", schema: expanded, depth: depth + 1 %>
          </div>
        <% end %>
      </li>
    <% end %>
  </ul>
<% elsif items.present? %>
  <%= render "schema", schema: items, depth: depth %>
<% end %>
