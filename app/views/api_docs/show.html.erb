<% content_for :title, t("api_docs.title") %>

<div class="mx-auto max-w-5xl px-4 py-10 sm:px-6 lg:px-8">
  <header class="border-b border-slate-200 pb-8">
    <p class="text-sm font-medium text-sky-700"><%= t("api_docs.eyebrow") %></p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight"><%= @document.dig("info", "title") %></h1>
    <p class="mt-2 text-lg text-slate-600"><%= @document.dig("info", "summary") %></p>

    <%# What this node is, so a reader knows why the reference is the length it is. %>
    <dl class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-4">
      <div>
        <dt class="text-xs uppercase tracking-wide text-slate-500"><%= t("api_docs.node.mode") %></dt>
        <dd class="mt-1 font-medium"><%= t("modes.#{SislabSync.mode}") %></dd>
      </div>
      <div>
        <dt class="text-xs uppercase tracking-wide text-slate-500"><%= t("api_docs.node.code") %></dt>
        <dd class="mt-1 font-mono font-medium"><%= SislabSync.node_code %></dd>
      </div>
      <div>
        <dt class="text-xs uppercase tracking-wide text-slate-500"><%= t("api_docs.node.version") %></dt>
        <dd class="mt-1 font-mono font-medium"><%= SislabSync.version %></dd>
      </div>
      <div>
        <dt class="text-xs uppercase tracking-wide text-slate-500"><%= t("api_docs.node.download") %></dt>
        <dd class="mt-1 space-x-2 font-medium">
          <%= link_to "JSON", api_docs_path(format: :json), class: "text-sky-700 hover:underline" %>
          <%= link_to "YAML", api_docs_path(format: :yaml), class: "text-sky-700 hover:underline" %>
        </dd>
      </div>
    </dl>

    <p class="mt-6 rounded-md bg-amber-50 px-4 py-3 text-sm text-amber-900 ring-1 ring-amber-600/20">
      <%= t("api_docs.scoped_to_node_html", mode: t("modes.#{SislabSync.mode}")) %>
    </p>
  </header>

  <section class="contract-prose mt-8 text-slate-700">
    <%= contract_prose(@document.dig("info", "description")) %>
  </section>

  <nav class="mt-10 rounded-lg bg-slate-50 p-5 ring-1 ring-slate-200">
    <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500"><%= t("api_docs.contents") %></h2>
    <ul class="mt-3 space-y-1 text-sm">
      <% @operations.group_by(&:tag).each do |group, operations| %>
        <li>
          <a href="#<%= group.parameterize %>" class="font-medium text-sky-700 hover:underline"><%= group %></a>
          <span class="text-slate-500">— <%= t("api_docs.operation_count", count: operations.size) %></span>
        </li>
      <% end %>
    </ul>
  </nav>

  <% @operations.group_by(&:tag).each do |group, operations| %>
    <section id="<%= group.parameterize %>" class="mt-12 scroll-mt-6">
      <h2 class="text-2xl font-semibold tracking-tight"><%= group %></h2>

      <% if (description = @document.fetch("tags", []).find { |entry| entry["name"] == group }&.dig("description")) %>
        <div class="contract-prose mt-2 text-slate-600"><%= contract_prose(description) %></div>
      <% end %>

      <div class="mt-6 space-y-6">
        <% operations.each do |operation| %>
          <%= render "operation", operation: operation %>
        <% end %>
      </div>
    </section>
  <% end %>

  <footer class="mt-16 border-t border-slate-200 pt-6 text-sm text-slate-500">
    <%= t("api_docs.footer_html", path: tag.code("docs/sislab-sync/openapi.yaml", class: "contract-code")) %>
  </footer>
</div>
