# The national node: owns the dictionary, receives events, routes referrals.
# cp .env.national.example .env

SISLAB_SYNC_MODE=national
SISLAB_SYNC_FACILITY_CODE=NATIONAL

# Set to false on a production node reached over plain HTTP, with no reverse
# proxy terminating TLS in front of it. Only read in RAILS_ENV=production.
SISLAB_SYNC_TLS_TERMINATED=true

RAILS_ENV=development
APP_PORT=3100

DATABASE_NAME=sislab_sync_national_development
DATABASE_USER=root
DATABASE_PASSWORD=sislab

# Source database for the dictionary import. Read-only: the import never writes
# to mLab. Fill the password in your own .env — an example file that carries a
# real one puts it in the repository, and from there into every clone.
MLAB_DB_HOST=127.0.0.1
MLAB_DB_PORT=3306
MLAB_DB_USER=root
MLAB_DB_PASSWORD=
MLAB_DB_NAME=mlab

# Or read the same dictionary through the mLab API, with
# `dictionary:import_from_mlab_api`, for when only HTTP is open. Set
# MLAB_API_TOKEN to a token issued out of band, or a user and password for the
# import to log in with. Same rule as above: keep the password in your own .env.
MLAB_API_URL=http://127.0.0.1:8005
MLAB_API_USER=
MLAB_API_PASSWORD=
