# The national node: owns the dictionary, receives events, routes referrals.
# cp .env.national.example .env

SISLAB_SYNC_MODE=national
SISLAB_SYNC_NODE_CODE=NATIONAL

RAILS_ENV=development
APP_PORT=3100

DATABASE_NAME=sislab_sync_national_development
DATABASE_USER=root
DATABASE_PASSWORD=sislab

# Source database for the dictionary import. Read-only: the import never writes
# to mLab. Fill the password in your own .env — an example file that carries a
# real one puts it in the repository, and from there into every clone.
MLAB_DB_HOST=127.0.0.1
MLAB_DB_PORT=3306
MLAB_DB_USER=root
MLAB_DB_PASSWORD=
MLAB_DB_NAME=mlab
