# A facility node: serves the EMR and the SISLAB, pushes upwards.
# cp .env.local.example .env

SISLAB_SYNC_MODE=local

# How this node identifies itself to the national node: the code of its entry
# in the national register of laboratories (`labs`), which the capital publishes
# and every node replicates. It is the only identity a node has to be given —
# the health facility, the name and the district are read from that entry once
# it arrives, and the keys issued here inherit them.
#
# SISLAB_SYNC_NODE_CODE is still read, for nodes installed before the register
# existed. It means the same thing.
SISLAB_SYNC_LAB_CODE=HCM

# Where the national node lives. Left blank until S9.
SISLAB_SYNC_NATIONAL_URL=
SISLAB_SYNC_NATIONAL_API_KEY=

# Set to false on a production node reached over plain HTTP, with no reverse
# proxy terminating TLS in front of it. Only read in RAILS_ENV=production.
SISLAB_SYNC_TLS_TERMINATED=true

RAILS_ENV=development
APP_PORT=3000

DATABASE_NAME=sislab_sync_development
DATABASE_USER=root
DATABASE_PASSWORD=sislab
